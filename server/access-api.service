[Unit]
Description=CS2 Donate Interact access API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/cs2-access
EnvironmentFile=/etc/cs2-access.env
ExecStart=/usr/bin/python3 /opt/cs2-access/access_api.py --host 0.0.0.0 --port 8767
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
