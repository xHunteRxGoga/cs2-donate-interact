[Unit]
Description=CS2 Donate Interact voice relay
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cs2-voice
EnvironmentFile=/etc/cs2-voice.env
ExecStart=/opt/cs2-voice/venv/bin/python /opt/cs2-voice/voice_relay.py --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
